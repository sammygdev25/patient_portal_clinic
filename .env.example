# Local development values.
# Production: DEBUG=0, a long random SECRET_KEY, ALLOWED_HOSTS and CORS_ALLOWED_ORIGINS set to your domains,
# SEED_DEMO unset. With DEBUG=0 the app is HTTPS only; set SECURE_SSL_REDIRECT=0 only behind a proxy that does not send X-Forwarded-Proto.
SECRET_KEY=${SECRET_KEY:-changeme-in-production}
DEBUG=1
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=1
SEED_DEMO=1
# This app's own demo passwords (made when it was generated, kept in backend/.env); start.sh reads them from there
# or from the environment. Also one SEED_<ROLE>_PASSWORD per role. With none set, no demo account can sign in.
SEED_DEMO_PASSWORD=choose-a-demo-password
SEED_STAFF_PASSWORD=choose-a-staff-password

# Database (PostgreSQL). Unset, previews start a local server; production must set it.
DATABASE_URL=postgresql://app:app@localhost:5432/app

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000/api
